{
  "name": "snipeit-playwright-e2etest",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end UI test for the Snipe-IT demo: create a checked-out asset and verify it in the list, on its page and in its history.",
  "scripts": {
    "pretest": "playwright install chromium",
    "test": "playwright test",
    "pretest:headed": "playwright install chromium",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
